"use client";

import { useCallback, useEffect, useMemo, useRef, useState } from "react";
import type { ChangeEvent, DragEvent, KeyboardEvent } from "react";
import {
  ACCEPTED_MIME,
  MAX_FILE_BYTES,
  MAX_FILES,
  compressImage,
  formatBytes,
  outputName,
} from "@/lib/tools/image-core";
import type {
  CompressOptions,
  CompressResult,
  ImageWorkerRequest,
  ImageWorkerResponse,
  OutputFormat,
  Stage,
} from "@/lib/tools/image-core";
import { createZip } from "@/lib/tools/zip-core";

type ItemStatus = "queued" | "working" | "done" | "error" | "cancelled";

interface DoneResult extends CompressResult {
  url: string;
  settingsKey: string;
}

interface Item {
  id: string;
  file: File;
  status: ItemStatus;
  progress: number;
  stage: string;
  error: string | null;
  result: DoneResult | null;
}

interface Pending {
  reqId: number;
  file: File;
  opts: CompressOptions;
  resolve: (result: CompressResult) => void;
  reject: (error: Error) => void;
  onStage: (stage: Stage) => void;
}

const STAGE_INFO: Record<Stage, { label: string; pct: number }> = {
  decoding: { label: "Decoding image", pct: 20 },
  drawing: { label: "Resizing", pct: 50 },
  encoding: { label: "Encoding", pct: 78 },
  finalizing: { label: "Finishing", pct: 95 },
};

const FORMAT_OPTIONS: { value: OutputFormat; label: string }[] = [
  { value: "auto", label: "Keep original type" },
  { value: "image/jpeg", label: "JPEG" },
  { value: "image/webp", label: "WebP" },
  { value: "image/png", label: "PNG" },
];

const DIMENSION_PRESETS: { value: number; label: string }[] = [
  { value: 0, label: "Original size" },
  { value: 3840, label: "4K — 3840 px" },
  { value: 2560, label: "2560 px" },
  { value: 1920, label: "Full HD — 1920 px" },
  { value: 1280, label: "1280 px" },
  { value: 1080, label: "1080 px" },
  { value: 800, label: "800 px" },
  { value: 512, label: "512 px" },
];

const EXT_MIME: Record<string, string> = {
  jpg: "image/jpeg",
  jpeg: "image/jpeg",
  png: "image/png",
  webp: "image/webp",
  gif: "image/gif",
  bmp: "image/bmp",
  avif: "image/avif",
};

function detectMime(file: File): string {
  if (file.type) return file.type;
  const ext = file.name.split(".").pop()?.toLowerCase() ?? "";
  return EXT_MIME[ext] ?? "";
}

function saveBlob(blob: Blob, name: string): void {
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = name;
  document.body.appendChild(a);
  a.click();
  a.remove();
  window.setTimeout(() => URL.revokeObjectURL(url), 10_000);
}

function ProgressBar({ value, label }: { value: number; label: string }) {
  const pct = Math.max(0, Math.min(100, Math.round(value)));
  return (
    <div
      role="progressbar"
      aria-label={label}
      aria-valuemin={0}
      aria-valuemax={100}
      aria-valuenow={pct}
      className="h-2 w-full overflow-hidden rounded-full bg-slate-200 dark:bg-slate-700"
    >
      <div
        className="h-full rounded-full bg-brand-600 transition-[width] duration-300"
        style={{ width: `${pct}%` }}
      />
    </div>
  );
}

function fileOutputName(item: Item): string {
  const r = item.result;
  if (!r) return item.file.name;
  return r.keptOriginal ? item.file.name : outputName(item.file.name, r.mime);
}

export default function ImageCompressorTool() {
  const [items, setItems] = useState<Item[]>([]);
  const [format, setFormat] = useState<OutputFormat>("auto");
  const [qualityPct, setQualityPct] = useState(80);
  const [maxDimension, setMaxDimension] = useState(0);
  const [background, setBackground] = useState("#ffffff");
  const [running, setRunning] = useState(false);
  const [notices, setNotices] = useState<string[]>([]);
  const [dragging, setDragging] = useState(false);
  const [zipBusy, setZipBusy] = useState(false);

  const itemsRef = useRef<Item[]>([]);
  const queueRef = useRef<string[]>([]);
  const genRef = useRef(0);
  const pumpingRef = useRef(false);
  const idCounter = useRef(0);
  const dragDepth = useRef(0);
  const fileInputRef = useRef<HTMLInputElement>(null);
  const workerRef = useRef<Worker | null>(null);
  const workerOkRef = useRef(true);
  const reqIdRef = useRef(0);
  const pendingRef = useRef<Pending | null>(null);

  const options = useMemo<CompressOptions>(
    () => ({ format, quality: qualityPct / 100, maxDimension, background }),
    [format, qualityPct, maxDimension, background],
  );
  const settingsKey = useMemo(
    () => JSON.stringify([format, qualityPct, maxDimension, background]),
    [format, qualityPct, maxDimension, background],
  );
  const optionsRef = useRef(options);
  const keyRef = useRef(settingsKey);
  useEffect(() => {
    optionsRef.current = options;
    keyRef.current = settingsKey;
  }, [options, settingsKey]);

  const updateItems = useCallback((fn: (list: Item[]) => Item[]) => {
    const next = fn(itemsRef.current);
    itemsRef.current = next;
    setItems(next);
  }, []);

  const patchItem = useCallback(
    (id: string, patch: Partial<Item>) => {
      updateItems((list) => list.map((i) => (i.id === id ? { ...i, ...patch } : i)));
    },
    [updateItems],
  );

  const disposeWorker = useCallback(() => {
    if (workerRef.current) {
      workerRef.current.terminate();
      workerRef.current = null;
    }
  }, []);

  const getWorker = useCallback((): Worker | null => {
    if (!workerOkRef.current) return null;
    if (typeof Worker === "undefined" || typeof OffscreenCanvas === "undefined") {
      workerOkRef.current = false;
      return null;
    }
    if (workerRef.current) return workerRef.current;
    try {
      const worker = new Worker(new URL("./workers/image.worker.ts", import.meta.url), {
        type: "module",
      });
      worker.onmessage = (event: MessageEvent<ImageWorkerResponse>) => {
        const msg = event.data;
        const pending = pendingRef.current;
        if (!pending || pending.reqId !== msg.id) return;
        if (msg.type === "stage") {
          pending.onStage(msg.stage);
          return;
        }
        pendingRef.current = null;
        if (msg.type === "done") {
          pending.resolve(msg.result);
          return;
        }
        if (msg.unsupported) {
          workerOkRef.current = false;
          disposeWorker();
          compressImage(pending.file, pending.opts, pending.onStage).then(
            pending.resolve,
            pending.reject,
          );
          return;
        }
        pending.reject(new Error(msg.message));
      };
      worker.onerror = (event: ErrorEvent) => {
        event.preventDefault();
        const pending = pendingRef.current;
        pendingRef.current = null;
        disposeWorker();
        pending?.reject(
          new Error(
            "The image worker crashed. The file is probably too large for this device's memory.",
          ),
        );
      };
      workerRef.current = worker;
      return worker;
    } catch {
      workerOkRef.current = false;
      return null;
    }
  }, [disposeWorker]);

  const runOne = useCallback(
    (file: File, opts: CompressOptions, onStage: (stage: Stage) => void): Promise<CompressResult> => {
      const worker = getWorker();
      if (!worker) return compressImage(file, opts, onStage);
      return new Promise<CompressResult>((resolve, reject) => {
        const reqId = ++reqIdRef.current;
        pendingRef.current = { reqId, file, opts, resolve, reject, onStage };
        const request: ImageWorkerRequest = { id: reqId, file, options: opts };
        try {
          worker.postMessage(request);
        } catch (error) {
          pendingRef.current = null;
          reject(error instanceof Error ? error : new Error("Could not start the image worker."));
        }
      });
    },
    [getWorker],
  );

  const pump = useCallback(async () => {
    if (pumpingRef.current) return;
    pumpingRef.current = true;
    setRunning(true);
    const gen = genRef.current;

    while (genRef.current === gen && queueRef.current.length > 0) {
      const id = queueRef.current.shift() as string;
      const item = itemsRef.current.find((i) => i.id === id);
      if (!item || item.status === "working") continue;

      const opts = optionsRef.current;
      const key = keyRef.current;
      if (item.result) URL.revokeObjectURL(item.result.url);
      patchItem(id, {
        status: "working",
        progress: 4,
        stage: "Reading file",
        error: null,
        result: null,
      });

      try {
        const result = await runOne(item.file, opts, (stage) => {
          if (genRef.current === gen) {
            patchItem(id, { progress: STAGE_INFO[stage].pct, stage: STAGE_INFO[stage].label });
          }
        });
        if (genRef.current !== gen) return;
        const url = URL.createObjectURL(result.blob);
        if (!itemsRef.current.some((i) => i.id === id)) {
          URL.revokeObjectURL(url);
          continue;
        }
        patchItem(id, {
          status: "done",
          progress: 100,
          stage: "Done",
          result: { ...result, url, settingsKey: key },
        });
      } catch (error) {
        if (genRef.current !== gen) return;
        patchItem(id, {
          status: "error",
          progress: 0,
          stage: "",
          error: error instanceof Error ? error.message : "Something went wrong.",
        });
      }
    }

    if (genRef.current === gen) {
      pumpingRef.current = false;
      setRunning(false);
    }
  }, [patchItem, runOne]);

  const enqueue = useCallback(
    (ids: string[]) => {
      const eligible = ids.filter((id) => {
        const item = itemsRef.current.find((i) => i.id === id);
        return item !== undefined && item.status !== "working";
      });
      if (eligible.length === 0) return;
      const set = new Set(eligible);
      updateItems((list) =>
        list.map((i) => {
          if (!set.has(i.id)) return i;
          if (i.result) URL.revokeObjectURL(i.result.url);
          return { ...i, status: "queued", progress: 0, stage: "Waiting", error: null, result: null };
        }),
      );
      for (const id of eligible) {
        if (!queueRef.current.includes(id)) queueRef.current.push(id);
      }
      void pump();
    },
    [pump, updateItems],
  );

  const cancelAll = useCallback(() => {
    genRef.current += 1;
    queueRef.current = [];
    pumpingRef.current = false;
    const pending = pendingRef.current;
    pendingRef.current = null;
    disposeWorker();
    pending?.reject(new Error("cancelled"));
    setRunning(false);
    updateItems((list) =>
      list.map((i) =>
        i.status === "working" || i.status === "queued"
          ? { ...i, status: "cancelled", progress: 0, stage: "", error: null }
          : i,
      ),
    );
  }, [disposeWorker, updateItems]);

  const addFiles = useCallback(
    (fileList: FileList | File[]) => {
      const incoming = Array.from(fileList);
      const messages: string[] = [];
      const accepted: Item[] = [];
      let slots = MAX_FILES - itemsRef.current.length;

      for (const file of incoming) {
        const mime = detectMime(file);
        if (mime === "image/svg+xml" || /\.svg$/i.test(file.name)) {
          messages.push(`${file.name}: SVG is already vector. Use an SVG optimiser instead.`);
          continue;
        }
        if (!ACCEPTED_MIME.has(mime)) {
          messages.push(`${file.name}: not a supported image (JPEG, PNG, WebP, GIF, BMP or AVIF).`);
          continue;
        }
        if (file.size === 0) {
          messages.push(`${file.name}: the file is empty.`);
          continue;
        }
        if (file.size > MAX_FILE_BYTES) {
          messages.push(`${file.name}: larger than ${Math.round(MAX_FILE_BYTES / 1048576)} MB.`);
          continue;
        }
        if (slots <= 0) {
          messages.push(`${file.name}: skipped, the limit is ${MAX_FILES} files at once.`);
          continue;
        }
        slots -= 1;
        idCounter.current += 1;
        accepted.push({
          id: `img-${idCounter.current}`,
          file,
          status: "queued",
          progress: 0,
          stage: "Waiting",
          error: null,
          result: null,
        });
      }

      if (messages.length > 0) setNotices((prev) => [...prev, ...messages].slice(-8));
      if (accepted.length > 0) {
        updateItems((list) => [...list, ...accepted]);
        queueRef.current.push(...accepted.map((a) => a.id));
        void pump();
      }
    },
    [pump, updateItems],
  );

  const removeItem = useCallback(
    (id: string) => {
      const item = itemsRef.current.find((i) => i.id === id);
      if (!item || item.status === "working") return;
      if (item.result) URL.revokeObjectURL(item.result.url);
      queueRef.current = queueRef.current.filter((q) => q !== id);
      updateItems((list) => list.filter((i) => i.id !== id));
    },
    [updateItems],
  );

  const clearAll = useCallback(() => {
    cancelAll();
    for (const item of itemsRef.current) {
      if (item.result) URL.revokeObjectURL(item.result.url);
    }
    updateItems(() => []);
    setNotices([]);
  }, [cancelAll, updateItems]);

  useEffect(() => {
    return () => {
      genRef.current += 1;
      disposeWorker();
      for (const item of itemsRef.current) {
        if (item.result) URL.revokeObjectURL(item.result.url);
      }
    };
  }, [disposeWorker]);

  const downloadZip = useCallback(async () => {
    const done = itemsRef.current.filter((i) => i.result !== null);
    if (done.length === 0) return;
    setZipBusy(true);
    try {
      const entries = done.map((item) => ({
        name: fileOutputName(item),
        blob: (item.result as DoneResult).blob,
        lastModified: item.file.lastModified,
      }));
      const zip = await createZip(entries);
      saveBlob(zip, "toolglobe-images.zip");
    } catch (error) {
      setNotices((prev) =>
        [...prev, error instanceof Error ? error.message : "Could not build the ZIP."].slice(-8),
      );
    } finally {
      setZipBusy(false);
    }
  }, []);

  const stats = useMemo(() => {
    let original = 0;
    let output = 0;
    let done = 0;
    let failed = 0;
    let waiting = 0;
    let working: Item | null = null;
    for (const item of items) {
      if (item.status === "done" && item.result) {
        done += 1;
        original += item.file.size;
        output += item.result.blob.size;
      } else if (item.status === "error") failed += 1;
      else if (item.status === "working") working = item;
      else if (item.status === "queued") waiting += 1;
    }
    return { original, output, done, failed, waiting, working };
  }, [items]);

  const overallPct = useMemo(() => {
    const active = items.filter((i) => i.status !== "cancelled");
    if (active.length === 0) return 0;
    const sum = active.reduce((acc, i) => {
      if (i.status === "done" || i.status === "error") return acc + 100;
      if (i.status === "working") return acc + i.progress;
      return acc;
    }, 0);
    return Math.round(sum / active.length);
  }, [items]);

  const retryIds = useMemo(
    () =>
      items
        .filter(
          (i) =>
            i.status === "cancelled" ||
            i.status === "error" ||
            (i.status === "done" && i.result !== null && i.result.settingsKey !== settingsKey),
        )
        .map((i) => i.id),
    [items, settingsKey],
  );
  const staleCount = items.filter(
    (i) => i.status === "done" && i.result !== null && i.result.settingsKey !== settingsKey,
  ).length;

  const savedPct = stats.original > 0 ? Math.round((1 - stats.output / stats.original) * 100) : 0;
  const hasPng = items.some((i) => detectMime(i.file) === "image/png");
  const pngHint = hasPng && (format === "auto" || format === "image/png");
  const showBackground = format === "auto" || format === "image/jpeg";

  const onDragEnter = (e: DragEvent<HTMLDivElement>) => {
    e.preventDefault();
    dragDepth.current += 1;
    setDragging(true);
  };
  const onDragOver = (e: DragEvent<HTMLDivElement>) => {
    e.preventDefault();
  };
  const onDragLeave = (e: DragEvent<HTMLDivElement>) => {
    e.preventDefault();
    dragDepth.current = Math.max(0, dragDepth.current - 1);
    if (dragDepth.current === 0) setDragging(false);
  };
  const onDrop = (e: DragEvent<HTMLDivElement>) => {
    e.preventDefault();
    dragDepth.current = 0;
    setDragging(false);
    if (e.dataTransfer.files && e.dataTransfer.files.length > 0) addFiles(e.dataTransfer.files);
  };
  const onZoneKey = (e: KeyboardEvent<HTMLDivElement>) => {
    if (e.key === "Enter" || e.key === " ") {
      e.preventDefault();
      fileInputRef.current?.click();
    }
  };
  const onInputChange = (e: ChangeEvent<HTMLInputElement>) => {
    if (e.target.files && e.target.files.length > 0) addFiles(e.target.files);
    e.target.value = "";
  };

  return (
    <div className="space-y-6">
      <div
        role="button"
        tabIndex={0}
        aria-label="Add images. Drop files here or press Enter to browse."
        onClick={() => fileInputRef.current?.click()}
        onKeyDown={onZoneKey}
        onDragEnter={onDragEnter}
        onDragOver={onDragOver}
        onDragLeave={onDragLeave}
        onDrop={onDrop}
        className={`card flex cursor-pointer flex-col items-center justify-center gap-3 border-2 border-dashed p-10 text-center transition-colors ${
          dragging
            ? "border-brand-500 bg-brand-50 dark:bg-brand-950/30"
            : "border-slate-300 hover:border-brand-400 dark:border-slate-600"
        }`}
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          className="h-10 w-10 text-brand-600"
          fill="none"
          stroke="currentColor"
          strokeWidth="1.8"
          strokeLinecap="round"
          strokeLinejoin="round"
        >
          <path d="M12 16V4" />
          <path d="m7 9 5-5 5 5" />
          <path d="M20 16v3a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-3" />
        </svg>
        <p className="text-base font-semibold text-slate-900 dark:text-slate-100">
          Drop images here, or click to browse
        </p>
        <p className="text-sm text-slate-600 dark:text-slate-400">
          JPEG, PNG, WebP, GIF, BMP, AVIF · up to {Math.round(MAX_FILE_BYTES / 1048576)} MB each ·
          up to {MAX_FILES} files · nothing is uploaded
        </p>
        <input
          ref={fileInputRef}
          type="file"
          multiple
          accept="image/jpeg,image/png,image/webp,image/gif,image/bmp,image/avif"
          className="hidden"
          onChange={onInputChange}
        />
      </div>

      <div className="card space-y-5 p-5">
        <div className="grid gap-5 md:grid-cols-2">
          <div>
            <p className="mb-2 text-sm font-medium text-slate-900 dark:text-slate-100">
              Output format
            </p>
            <div role="group" aria-label="Output format" className="flex flex-wrap gap-2">
              {FORMAT_OPTIONS.map((opt) => (
                <button
                  key={opt.value}
                  type="button"
                  aria-pressed={format === opt.value}
                  onClick={() => setFormat(opt.value)}
                  className={format === opt.value ? "btn-primary" : "btn-secondary"}
                >
                  {opt.label}
                </button>
              ))}
            </div>
          </div>

          <div>
            <label
              htmlFor="img-quality"
              className="mb-2 flex items-center justify-between text-sm font-medium text-slate-900 dark:text-slate-100"
            >
              <span>Quality</span>
              <span className="chip">{qualityPct}%</span>
            </label>
            <input
              id="img-quality"
              type="range"
              min={10}
              max={100}
              step={1}
              value={qualityPct}
              disabled={format === "image/png"}
              onChange={(e) => setQualityPct(Number(e.target.value))}
              className="w-full accent-brand-600 disabled:opacity-50"
            />
            <p className="mt-1 text-xs text-slate-500 dark:text-slate-400">
              Lower = smaller file. 75–85% is a good default for photos.
            </p>
          </div>

          <div>
            <label
              htmlFor="img-dimension"
              className="mb-2 block text-sm font-medium text-slate-900 dark:text-slate-100"
            >
              Maximum width / height
            </label>
            <select
              id="img-dimension"
              className="input"
              value={maxDimension}
              onChange={(e) => setMaxDimension(Number(e.target.value))}
            >
              {DIMENSION_PRESETS.map((p) => (
                <option key={p.value} value={p.value}>
                  {p.label}
                </option>
              ))}
            </select>
            <p className="mt-1 text-xs text-slate-500 dark:text-slate-400">
              Scales the longest edge down. Small images are never enlarged.
            </p>
          </div>

          {showBackground && (
            <div>
              <label
                htmlFor="img-bg"
                className="mb-2 block text-sm font-medium text-slate-900 dark:text-slate-100"
              >
                Background for transparent areas (JPEG)
              </label>
              <div className="flex items-center gap-3">
                <input
                  id="img-bg"
                  type="color"
                  value={background}
                  onChange={(e) => setBackground(e.target.value)}
                  className="h-10 w-14 cursor-pointer rounded border border-slate-300 bg-transparent dark:border-slate-600"
                />
                <span className="text-sm text-slate-600 dark:text-slate-400">{background}</span>
              </div>
            </div>
          )}
        </div>

        {pngHint && (
          <p className="rounded-lg bg-amber-50 p-3 text-sm text-amber-900 dark:bg-amber-950/40 dark:text-amber-200">
            PNG is lossless, so the quality slider does not change PNG output. To shrink PNG
            files, lower the maximum width, or convert photos to WebP or JPEG.
          </p>
        )}
      </div>

      {notices.length > 0 && (
        <div
          role="alert"
          className="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-900 dark:border-red-900 dark:bg-red-950/40 dark:text-red-200"
        >
          <div className="flex items-start justify-between gap-3">
            <ul className="list-disc space-y-1 pl-5">
              {notices.map((n, i) => (
                <li key={`${i}-${n}`}>{n}</li>
              ))}
            </ul>
            <button type="button" className="btn-ghost" onClick={() => setNotices([])}>
              Dismiss
            </button>
          </div>
        </div>
      )}

      {items.length > 0 && (
        <div className="card space-y-4 p-5">
          <div className="flex flex-wrap items-center justify-between gap-3">
            <div className="text-sm text-slate-700 dark:text-slate-300" aria-live="polite">
              <p className="font-semibold text-slate-900 dark:text-slate-100">
                {stats.done} of {items.length} compressed
                {stats.failed > 0 ? ` · ${stats.failed} failed` : ""}
              </p>
              {stats.done > 0 && (
                <p>
                  {formatBytes(stats.original)} → {formatBytes(stats.output)}{" "}
                  <span
                    className={
                      savedPct > 0
                        ? "font-semibold text-emerald-600 dark:text-emerald-400"
                        : "font-semibold text-amber-600 dark:text-amber-400"
                    }
                  >
                    ({savedPct > 0 ? `${savedPct}% smaller` : `${Math.abs(savedPct)}% larger`})
                  </span>
                </p>
              )}
              {running && stats.working && (
                <p className="text-slate-500 dark:text-slate-400">
                  {stats.working.stage || "Working"} · {stats.working.file.name}
                </p>
              )}
            </div>

            <div className="flex flex-wrap gap-2">
              {running && (
                <button type="button" className="btn-secondary" onClick={cancelAll}>
                  Cancel
                </button>
              )}
              {!running && retryIds.length > 0 && (
                <button type="button" className="btn-secondary" onClick={() => enqueue(retryIds)}>
                  {staleCount > 0 ? "Recompress" : "Retry"} {retryIds.length} file
                  {retryIds.length === 1 ? "" : "s"}
                </button>
              )}
              <button
                type="button"
                className="btn-primary"
                disabled={stats.done === 0 || zipBusy}
                onClick={downloadZip}
              >
                {zipBusy ? "Building ZIP…" : `Download all (${stats.done}) as ZIP`}
              </button>
              <button type="button" className="btn-ghost" onClick={clearAll}>
                Clear all
              </button>
            </div>
          </div>

          {(running || stats.waiting > 0) && <ProgressBar value={overallPct} label="Overall progress" />}

          {staleCount > 0 && !running && (
            <p className="text-sm text-amber-700 dark:text-amber-300">
              Settings changed since {staleCount} file{staleCount === 1 ? " was" : "s were"}{" "}
              compressed. Press “Recompress” to apply the new settings.
            </p>
          )}
        </div>
      )}

      {items.length > 0 && (
        <ul className="space-y-3">
          {items.map((item) => {
            const r = item.result;
            const stale = r !== null && r.settingsKey !== settingsKey;
            const delta = r ? Math.round((1 - r.blob.size / item.file.size) * 100) : 0;
            const resized = r !== null && (r.width !== r.originalWidth || r.height !== r.originalHeight);
            return (
              <li key={item.id} className="card flex flex-wrap items-center gap-4 p-4">
                <div className="flex h-16 w-16 shrink-0 items-center justify-center overflow-hidden rounded-lg bg-slate-100 dark:bg-slate-800">
                  {r ? (
                    // eslint-disable-next-line @next/next/no-img-element
                    <img src={r.url} alt="" className="h-full w-full object-cover" />
                  ) : (
                    <span className="text-xs text-slate-400">
                      {item.status === "working" ? "…" : "IMG"}
                    </span>
                  )}
                </div>

                <div className="min-w-0 flex-1">
                  <p className="truncate text-sm font-semibold text-slate-900 dark:text-slate-100">
                    {item.file.name}
                  </p>

                  {item.status === "done" && r && (
                    <div className="mt-1 space-y-1 text-sm text-slate-600 dark:text-slate-400">
                      <p>
                        {formatBytes(item.file.size)} → {formatBytes(r.blob.size)}{" "}
                        {r.keptOriginal ? (
                          <span className="chip">Already optimal — original kept</span>
                        ) : delta > 0 ? (
                          <span className="chip">{delta}% smaller</span>
                        ) : (
                          <span className="chip">{Math.abs(delta)}% larger</span>
                        )}
                        {stale && <span className="chip ml-1">Settings changed</span>}
                      </p>
                      <p className="text-xs">
                        {resized
                          ? `${r.originalWidth}×${r.originalHeight} → ${r.width}×${r.height}`
                          : `${r.width}×${r.height}`}{" "}
                        · {r.mime.replace("image/", "").toUpperCase()}
                        {r.fellBack ? " · WebP not supported here, JPEG used" : ""}
                      </p>
                    </div>
                  )}

                  {item.status === "working" && (
                    <div className="mt-2 space-y-1">
                      <ProgressBar value={item.progress} label={`Progress for ${item.file.name}`} />
                      <p className="text-xs text-slate-500 dark:text-slate-400">{item.stage}</p>
                    </div>
                  )}

                  {item.status === "queued" && (
                    <p className="mt-1 text-sm text-slate-500 dark:text-slate-400">
                      Waiting · {formatBytes(item.file.size)}
                    </p>
                  )}

                  {item.status === "cancelled" && (
                    <p className="mt-1 text-sm text-slate-500 dark:text-slate-400">
                      Cancelled · {formatBytes(item.file.size)}
                    </p>
                  )}

                  {item.status === "error" && (
                    <p role="alert" className="mt-1 text-sm text-red-600 dark:text-red-400">
                      {item.error}
                    </p>
                  )}
                </div>

                <div className="flex shrink-0 gap-2">
                  {item.status === "done" && r && (
                    <button
                      type="button"
                      className="btn-primary"
                      onClick={() => saveBlob(r.blob, fileOutputName(item))}
                    >
                      Download
                    </button>
                  )}
                  <button
                    type="button"
                    className="btn-ghost"
                    disabled={item.status === "working"}
                    onClick={() => removeItem(item.id)}
                    aria-label={`Remove ${item.file.name}`}
                  >
                    Remove
                  </button>
                </div>
              </li>
            );
          })}
        </ul>
      )}
    </div>
  );
}
